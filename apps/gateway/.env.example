# Untuk pengembangan lokal: salin ke .env (diabaikan git), lalu `pnpm --filter @aios/gateway dev`.
# Daftar lengkap dan default: src/config.ts. Di VPS pakai infra/compose/gateway.env.example.

# Postgres lokal, mis.: docker run --rm -p 127.0.0.1:5432:5432 -e POSTGRES_USER=aios -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=aios postgres:16
DATABASE_URL=postgres://aios:dev@127.0.0.1:5432/aios

# Minimal 32 karakter, mis. dari: openssl rand -base64 48
AUTH_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=
# Cakupan memori jangka panjang Hermes (X-Hermes-Session-Key). Gateway uji: jangan pakai owner.
HERMES_SESSION_KEY=owner
NINEROUTER_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
# Combo 9Router untuk model kecil (judul percakapan otomatis).
TITLE_MODEL=router-fast
# Combo 9Router untuk router role otomatis.
ROUTER_MODEL=router-fast
# Combo 9Router untuk deep research (rencana + laporan) dan untuk ringkasan per sumber.
RESEARCH_MODEL=research-main
RESEARCH_SUMMARY_MODEL=general-cheap
# Combo 9Router kecil untuk mengurai jadwal bahasa alami (POST /schedules/parse).
SCHEDULE_MODEL=router-fast
# Combo 9Router kecil untuk memecah ide menjadi kartu kanban.
TASK_MODEL=router-fast
# Batas run coding bersamaan per project; kartu berikutnya mengantre.
TASK_MAX_PARALLEL=2
# Memori: selama semua memori aktif muat di anggaran ini (karakter baris fakta di pesan sistem), semuanya disuntik;
# lebih dari itu dipilih per pesan (tersemat, cocok kata, terbaru). Kosong = 6000.
MEMORY_RECALL_BUDGET_CHARS=
# Maks fakta yang terpilih karena cocok kata dengan pesan, di luar yang tersemat. Kosong = 12.
MEMORY_RECALL_TOP_K=
# Ekstraksi fakta memori dari pesan pemilik di chat umum (docs/DESIGN_MEMORI_SEMANTIK.md 4.4).
# off (bawaan) = tidak ada pekerjaan dan tidak ada panggilan model; propose (disarankan saat dinyalakan) = usulan
# menunggu persetujuan di Memori; auto = langsung disimpan dengan asal terlihat dan bisa diurungkan.
MEMORY_EXTRACT_MODE=off
# Combo 9Router kecil untuk ekstraksi (suhu 0). Kosong = router-fast; produksi mengisinya seperti *_MODEL lain.
MEMORY_EXTRACT_MODEL=
# Batas panggilan model ekstraksi per 24 jam bergulir. Kosong = 40.
MEMORY_EXTRACT_DAILY_MAX=
# Push FCM ke Android: path file service account Firebase (di container: /run/secrets/fcm_service_account). Kosong = push mati.
FCM_SERVICE_ACCOUNT_FILE=
# Opsional: Chromium untuk halaman yang butuh JavaScript (mis. /usr/bin/chromium). Kosong = dilewati.
BROWSER_EXECUTABLE_PATH=
SEARXNG_URL=http://127.0.0.1:8888
# Tool gateway MCP untuk agent omp di worker (web_search, web_read). Bawaan mati.
MCP_TOOLS_ENABLED=false

# Opsional: tes integrasi memakai Postgres ini; tanpa ini tes memakai Postgres tertanam.
# TEST_DATABASE_URL=postgres://aios:dev@127.0.0.1:5432/postgres

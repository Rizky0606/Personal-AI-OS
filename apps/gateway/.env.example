# Untuk pengembangan lokal: salin ke .env (diabaikan git), lalu `pnpm --filter @aios/gateway dev`.
# Daftar lengkap dan default: src/config.ts. Di VPS pakai infra/compose/gateway.env.example.

# Postgres lokal, mis.: docker run --rm -p 127.0.0.1:5432:5432 -e POSTGRES_USER=aios -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=aios postgres:16
DATABASE_URL=postgres://aios:dev@127.0.0.1:5432/aios

# Minimal 32 karakter, mis. dari: openssl rand -base64 48
AUTH_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=debug

HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=
NINEROUTER_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
# Combo 9Router untuk model kecil (judul percakapan otomatis).
TITLE_MODEL=router-fast
# Combo 9Router untuk router role otomatis.
ROUTER_MODEL=router-fast
# Combo 9Router untuk deep research (rencana + laporan) dan untuk ringkasan per sumber.
RESEARCH_MODEL=research-main
RESEARCH_SUMMARY_MODEL=general-cheap
# Combo 9Router kecil untuk mengurai jadwal bahasa alami (POST /schedules/parse).
SCHEDULE_MODEL=router-fast
# Push FCM ke Android: path file service account Firebase (di container: /run/secrets/fcm_service_account). Kosong = push mati.
FCM_SERVICE_ACCOUNT_FILE=
# Opsional: Chromium untuk halaman yang butuh JavaScript (mis. /usr/bin/chromium). Kosong = dilewati.
BROWSER_EXECUTABLE_PATH=
SEARXNG_URL=http://127.0.0.1:8888

# Opsional: tes integrasi memakai Postgres ini; tanpa ini tes memakai Postgres tertanam.
# TEST_DATABASE_URL=postgres://aios:dev@127.0.0.1:5432/postgres

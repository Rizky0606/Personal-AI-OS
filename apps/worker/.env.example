# Worker dijalankan sebagai sidecar oleh aplikasi desktop (Tauri) dan tidak membaca .env.
# Variabel di bawah diisi oleh Tauri saat proses dimulai; isi manual hanya untuk menjalankan worker sendiri.

# Token lokal sekali pakai (>= 16 karakter) untuk koneksi pertama dari desktop.
AIOS_WORKER_TOKEN=
# Folder data worker (daftar folder izin, ikatan project). Default: %LOCALAPPDATA%\aios-worker.
AIOS_WORKER_DATA_DIR=

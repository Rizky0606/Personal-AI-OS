{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Izin jendela utama: inti Tauri, HTTP ke gateway, WebSocket, membuka tautan http/https di peramban sistem, dialog pilih folder, pemeriksaan pembaruan, serta hotkey global dan kendali jendela Quick Ask.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    },
    "websocket:default",
    "opener:default",
    "dialog:allow-open",
    "updater:default",
    "core:window:allow-get-all-windows",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}

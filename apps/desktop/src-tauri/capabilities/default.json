{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Izin jendela utama: inti Tauri, HTTP ke gateway, WebSocket, membuka tautan http/https di peramban sistem, dialog pilih folder, dan pemeriksaan pembaruan.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    },
    "websocket:default",
    "opener:default",
    "dialog:allow-open",
    "updater:default"
  ]
}

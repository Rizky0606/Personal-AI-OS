# Environment gateway. Salin ke gateway.env, chmod 600, jangan di-commit.
# Daftar lengkap dan default: apps/gateway/src/config.ts.

# Password sama dengan isi secrets/pg_password. Karakter khusus harus di-URL-encode.
DATABASE_URL=postgres://aios:GANTI_DENGAN_ISI_PG_PASSWORD@127.0.0.1:5432/aios

# Dengan network_mode host, JANGAN ubah HOST ke 0.0.0.0: gateway akan terbuka ke publik. Nginx yang publik.
# Rahasia autentikasi (JWT dan enkripsi secret TOTP), minimal 32 karakter: openssl rand -base64 48
# Mengubahnya mencabut semua token dan mengharuskan owner:init --reset.
AUTH_SECRET=

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=

NINEROUTER_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
# Combo 9Router untuk model kecil (judul percakapan otomatis).
TITLE_MODEL=router-fast
# Combo 9Router untuk router role otomatis.
ROUTER_MODEL=router-fast
# Combo 9Router untuk deep research (rencana + laporan) dan untuk ringkasan per sumber.
RESEARCH_MODEL=research-main
RESEARCH_SUMMARY_MODEL=general-cheap
# Combo 9Router kecil untuk mengurai jadwal bahasa alami (POST /schedules/parse).
SCHEDULE_MODEL=router-fast
# Combo 9Router kecil untuk memecah ide menjadi kartu kanban.
TASK_MODEL=router-fast
# Batas run coding bersamaan per project; kartu berikutnya mengantre.
TASK_MAX_PARALLEL=2
# Push FCM ke Android: path file service account Firebase (di container: /run/secrets/fcm_service_account). Kosong = push mati.
FCM_SERVICE_ACCOUNT_FILE=
# Opsional: Chromium untuk halaman yang butuh JavaScript (mis. /usr/bin/chromium). Kosong = dilewati.
BROWSER_EXECUTABLE_PATH=

SEARXNG_URL=http://127.0.0.1:8888

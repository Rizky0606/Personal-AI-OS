# Environment gateway. Salin ke gateway.env, chmod 600, jangan di-commit.
# Daftar lengkap dan default: apps/gateway/src/config.ts.

# Password sama dengan isi secrets/pg_password. Karakter khusus harus di-URL-encode.
DATABASE_URL=postgres://aios:GANTI_DENGAN_ISI_PG_PASSWORD@127.0.0.1:5432/aios

# Dengan network_mode host, JANGAN ubah HOST ke 0.0.0.0: gateway akan terbuka ke publik. Nginx yang publik.
# Rahasia autentikasi (JWT dan enkripsi secret TOTP), minimal 32 karakter: openssl rand -base64 48
# Mengubahnya mencabut semua token dan mengharuskan owner:init --reset.
AUTH_SECRET=

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=

NINEROUTER_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
# Combo 9Router untuk model kecil (judul percakapan otomatis).
TITLE_MODEL=router-fast
# Combo 9Router untuk router role otomatis.
ROUTER_MODEL=router-fast
# Combo 9Router untuk deep research (rencana + laporan) dan untuk ringkasan per sumber.
RESEARCH_MODEL=research-main
RESEARCH_SUMMARY_MODEL=general-cheap
# Combo 9Router kecil untuk mengurai jadwal bahasa alami (POST /schedules/parse).
SCHEDULE_MODEL=router-fast
# Combo 9Router kecil untuk memecah ide menjadi kartu kanban.
TASK_MODEL=router-fast
# Batas run coding bersamaan per project; kartu berikutnya mengantre.
TASK_MAX_PARALLEL=2
# Memori: selama semua memori aktif muat di anggaran ini (karakter baris fakta di pesan sistem, ±4 karakter per token),
# semuanya disuntik; lebih dari itu dipilih per pesan (tersemat, cocok kata, terbaru). Kosong = 6000.
MEMORY_RECALL_BUDGET_CHARS=
# Maks fakta yang terpilih karena cocok kata dengan pesan, di luar yang tersemat. Kosong = 12.
MEMORY_RECALL_TOP_K=
# Ekstraksi fakta memori dari pesan pemilik di chat umum (docs/DESIGN_MEMORI_SEMANTIK.md 4.4).
# off (bawaan) = tidak ada pekerjaan dan tidak ada panggilan model; propose (disarankan saat dinyalakan) = usulan
# menunggu persetujuan di Memori; auto = langsung disimpan dengan asal terlihat dan bisa diurungkan.
MEMORY_EXTRACT_MODE=off
# Combo 9Router kecil untuk ekstraksi (suhu 0). Kosong = router-fast; produksi mengisinya seperti *_MODEL lain.
MEMORY_EXTRACT_MODEL=
# Batas panggilan model ekstraksi per 24 jam bergulir. Kosong = 40.
MEMORY_EXTRACT_DAILY_MAX=
# Push FCM ke Android: path file service account Firebase (di container: /run/secrets/fcm_service_account). Kosong = push mati.
FCM_SERVICE_ACCOUNT_FILE=
# Opsional: Chromium untuk halaman yang butuh JavaScript (mis. /usr/bin/chromium). Kosong = dilewati.
BROWSER_EXECUTABLE_PATH=

SEARXNG_URL=http://127.0.0.1:8888
# Tool gateway untuk agent lewat MCP (POST /v1/mcp, server `aios_tools`: web_search lewat SearXNG di atas dan
# web_read lewat pengambil halaman aman SSRF). OPSIONAL, bawaan mati (false): route 404 dan run coding tidak
# mendapat tool. true = agent omp di worker bisa mencari web sendiri (izin jaringan tetap ditanyakan di desktop).
# Lihat docs/DESIGN_MCP_TOOLS.md.
MCP_TOOLS_ENABLED=false

# Engine dsh (DeepSeek Harness, developer preview, tidak diaudit): OPSIONAL, mati bila DSH_COMMAND kosong.
# Butuh image gateway yang dibangun dengan DSH_VERSION (lihat docs/RUNBOOK_DSH.md). Model lewat 9Router;
# kunci provider TIDAK diisi di sini: dsh memakai NINEROUTER_API_KEY di atas (diteruskan sebagai DSH_LLM_API_KEY).
DSH_COMMAND=
DSH_ARGS=--profile acp
# Di container: rumah dan folder kerja ada di volume /dsh (dimiliki pengguna node, bukan root).
DSH_HOME=/dsh/home
DSH_WORKDIR_ROOT=/dsh/work
DSH_MAX_MEMORY_MB=2048
DSH_RUN_TIMEOUT_MS=1800000
DSH_IDLE_TIMEOUT_MS=600000
DSH_APPROVAL_TIMEOUT_MS=600000

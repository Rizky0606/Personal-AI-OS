# Salin ke /etc/aios/backup.env, isi, lalu: chmod 600 /etc/aios/backup.env
# Jangan commit file yang sudah berisi nilai asli.

# Oracle Object Storage lewat API S3-compatible:
#   s3:https://<namespace>.compat.objectstorage.<region>.oraclecloud.com/<bucket>
RESTIC_REPOSITORY=
# Kata sandi enkripsi repositori restic disimpan di file terpisah (chmod 600). HILANG = backup tidak bisa dibuka.
RESTIC_PASSWORD_FILE=/etc/aios/restic-password
# Kunci akses S3 (Customer Secret Key Oracle) milik bucket ini saja.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Folder compose di VPS (berisi docker-compose.yml, .env, gateway.env, secrets/).
COMPOSE_DIR=/srv/personal-ai-os/infra/compose
# Folder data Hermes (memori, skill). Cari dengan: hermes config path  (atau lihat unit systemd Hermes).
HERMES_DATA_DIR=

# Opsional
#PG_SERVICE=postgres
#PG_USER=aios
#PG_DB=aios
#KEEP_DAILY=7
#KEEP_WEEKLY=4
#KEEP_MONTHLY=6
# URL push monitor Uptime Kuma (tipe "Push"): backup yang gagal atau tidak jalan memicu notifikasi Telegram.
#KUMA_PUSH_URL=http://127.0.0.1:3001/api/push/<token>
#KUMA_RESTORE_PUSH_URL=http://127.0.0.1:3001/api/push/<token-restore>

# Vhost nginx untuk gateway Personal AI OS. Salin ke /etc/nginx/sites-available/aios, ganti aios.contoh.com,
# aktifkan, lalu `nginx -t && systemctl reload nginx`. Sertifikat dari Let's Encrypt (certbot).
# Gateway hanya mendengarkan di 127.0.0.1:3000; nginx satu-satunya yang publik (443).

# Batas kasar di lapisan nginx, di depan rate limit gateway (login 5/menit per IP, API 120/menit per perangkat).
limit_req_zone $binary_remote_addr zone=aios_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=aios_api:10m rate=30r/s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name aios.contoh.com;
    return 301 https://$host$request_uri;
}

server {
    # nginx 1.24 (Ubuntu 24.04) belum mengenal "http2 on;"; sintaks ini jalan di 1.24 dan masih diterima (deprecated) di 1.25+.
    listen 443 ssl http2;
    server_name aios.contoh.com;

    ssl_certificate     /etc/letsencrypt/live/aios.contoh.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aios.contoh.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:aios_tls:10m;
    ssl_session_tickets off;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;

    # Lampiran maksimal 25 MB (docs/API_CONTRACT.md) ditambah overhead multipart.
    client_max_body_size 26m;

    # Hanya jalur aplikasi yang diteruskan; selain itu 404 (tidak ada halaman, dashboard, atau /metrics publik).
    location = /v1/auth/login {
        limit_req zone=aios_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/aios-proxy.conf;
    }

    location ~ ^/(v1|llm/v1)/ {
        limit_req zone=aios_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/aios-proxy.conf;
    }

    location / {
        return 404;
    }
}

# /etc/nginx/snippets/aios-proxy.conf:
#   proxy_http_version 1.1;
#   proxy_set_header Host $host;
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $remote_addr;   # menimpa, bukan menambah: gateway hanya percaya nginx
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header Upgrade $http_upgrade;           # WebSocket /v1/ws dan /v1/worker/ws
#   proxy_set_header Connection $connection_upgrade;
#   proxy_read_timeout 3600s;                         # WebSocket dan stream model panjang
#   proxy_send_timeout 3600s;
#   proxy_buffering off;                              # SSE (stream chat) tidak boleh ditahan

{
  "name": "personal-ai-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval:skills": "pnpm --filter @aios/gateway eval:skills --",
    "format": "prettier --write .",
    "shots": "pnpm --filter @aios/e2e shots",
    "shots:compare": "pnpm --filter @aios/e2e shots:compare",
    "skills:sync-hermes": "pnpm --filter @aios/gateway skills:sync-hermes --"
  },
  "devDependencies": {
    "@aios/config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
